# Wix Headless client for GearDaily2.0 (Wix Dashboard > Settings > Headless Settings)
NEXT_PUBLIC_WIX_CLIENT_ID=

# Public site URL, used for canonicals, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Wix blog URL (the "Read the Blog" link next to the newsletter signup)
NEXT_PUBLIC_BLOG_URL=https://www.geardaily.com/blog
